# Plantilla de configuración. Copiar a .env y ajustar:  cp .env.example .env
#
# .env está en .gitignore y nunca se versiona; este fichero sí, así que solo lleva
# valores de ejemplo: sin contraseñas, tokens, IPs internas ni nombres. En
# producción los secretos vienen del gestor institucional, no de aquí. Cada punto
# desarrollado en docs/SECURITY.md.

# --- Identidad ---------------------------------------------------------------
# External labels de Prometheus, para que varios laboratorios federados no
# colisionen. NOC_ENVIRONMENT evita que las alertas de un entorno lleguen a otro.
NOC_ENVIRONMENT=lab
NOC_MONITOR_NAME=mi-noc

# Interfaz de los puertos publicados: Prometheus 9090, Alertmanager 9093,
# ntfy 8085, Grafana 3000. Es una medida de seguridad, no de comodidad.
#   127.0.0.1  solo desde esta máquina. Correcto para trabajo local.
#   0.0.0.0    desde toda la red. Prometheus y Grafana sin TLS exponen métricas
#              y dejan escribir en el webhook de alertas: nunca así.
# En producción no se publica puerto: se llega por proxy TLS. La única excepción es
# ntfy, que sale para que la alerta llegue al móvil, y solo junto a
# NTFY_ENABLE_LOGIN=true y deny-all. Ver docs/INSTALL.md §6.
NOC_BIND_ADDRESS=127.0.0.1

# --- Retención de Prometheus --------------------------------------------------
# Si Prometheus se queda sin disco deja de escribir y se pierden también las
# métricas actuales: un fallo silencioso y nada habitual.
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=5GB

# --- Grafana ------------------------------------------------------------------
# Contraseña de ejemplo. Sin ella, Grafana no crea la cuenta inicial de admin y
# se queda inaccesible hasta que se configure por la UI.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-this-password

# --- ntfy (servidor de notificaciones autoalojado) ---------------------------
# ntfy propio y no el ntfy.sh público: mandar alertas internas a un tercero es una
# fuga de datos, y sin autenticación el topic es público y adivinable.
NTFY_TOPIC=noc-alerts

# Servicio interno de docker-compose.yml. Nunca un SaaS público con datos
# institucionales.
NTFY_URL=http://ntfy:80

# URL que ntfy incrusta en los enlaces y dirección que usa el móvil: alcanzable
# desde el dispositivo que LEE la alerta, no desde el que envía.
# Solo local, por defecto:  http://localhost:8085
# Desde un móvil:              http://<IP-LAN-de-esta-máquina>:8085
# Poner localhost aquí hace que en el móvil "localhost" sea el móvil y los enlaces
# apunten a nada. Ver la IP con: hostname -I (Linux/macOS) o ipconfig en Windows,
# usando el IPv4 del Wi-Fi, no los de WSL o Hyper-V.
NTFY_BASE_URL=http://localhost:8085

# Solo hace falta en un iPhone. La app solo mantiene socket directo con este
# servidor mientras está abierta, así que la notificación que la despierta viene
# de ntfy.sh, el servidor en la red push de Apple; con esta variable el servidor
# propio reenvía una consulta de sondeo y la app recoge el mensaje. La petición
# va a "<upstream>/<hash del topic>": ntfy.sh y Apple nunca ven la alerta. Vacío es
# lo correcto sin salida a internet. Activarlo cuesta el límite de tasa de
# ntfy.sh, que se sube con NTFY_UPSTREAM_ACCESS_TOKEN de una cuenta propia.
NTFY_UPSTREAM_BASE_URL=

# Si ntfy exige login. "false" solo es aceptable con el puerto en 127.0.0.1; poner
# "true" junto a NOC_BIND_ADDRESS=0.0.0.0, porque en red compartida un topic sin
# autenticar deja leer tus alertas y publicar fakes. Con el login activo:
#   docker compose exec ntfy ntfy user add --role=user
#   docker compose exec ntfy ntfy access <user> <topic> read-write
# La segunda es necesaria: sin ella el usuario existe pero no puede hacer nada.
NTFY_ENABLE_LOGIN=false

# Qué puede hacer un cliente sin autenticar; es lo que decide si el login
# anterior significa algo:
#   read-write  cualquiera que llegue al puerto lee y publica. Igual que no
#               tener auth; solo en 127.0.0.1.
#   deny-all    solo un usuario con permiso explícito sobre el topic. A usar en
#               cuanto el puerto sea alcanzable desde la red.
# Las tres van juntas: NOC_BIND_ADDRESS=0.0.0.0, NTFY_ENABLE_LOGIN=true y deny-all.
# Activar el login solo no cambia nada: lo anónimo conserva el acceso que se dio.
NTFY_AUTH_DEFAULT_ACCESS=read-write

# Credenciales que usa el PUENTE para publicar; ntfy no las lee, solo las exige.
# NTFY_TOKEN tiene prioridad sobre el par. No sirven si NTFY_ENABLE_LOGIN no es
# "true". Con el login activo y esto vacío, el puente no publica y las entregas
# fallan: las alertas se evalúan y las notificaciones se descartan, el peor fallo
# posible porque parece que todo funciona.
NTFY_USER=
NTFY_PASSWORD=
NTFY_TOKEN=

# --- ntfy-bridge --------------------------------------------------------------
# Token que el puente exige en /webhook; Alertmanager lo envía como
# "Authorization: Bearer <token>". Vacío, el puente acepta llamadas sin
# autenticar: tolerable si el puerto no sale de 127.0.0.1; si no, quien alcance el
# puerto puede inyectar notificaciones falsas. Generar: openssl rand -hex 32
BRIDGE_TOKEN=
# Verbosidad del log del puente: DEBUG vuelca cada payload del webhook y puede
# filtrar contenido de alerta a los logs, nunca en producción; INFO son los
# eventos que importan (recibida, entregada, reintentada); WARNING y ERROR,
# incidentes.
LOG_LEVEL=INFO
