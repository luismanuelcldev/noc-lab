# --- SECRETOS ----------------------------------------------------------------
# .env NUNCA se versiona: solo .env.example, y solo con valores de ejemplo.
.env
.env.*
!.env.example

# Configuracion local que pudiera guardar credenciales, IPs internas o tokens.
config/local/
*.local.yml
*.local.yaml
*.secret.yml
*.override.yml
*.override.yaml

# Prometheus lo genera al arrancar con las external labels ya sustituidas: lleva los
# nombres del monitor y del entorno. Lo escribe el entrypoint dentro del contenedor,
# pero el procedimiento manual de docs/OPERATIONS.md lo deja en la raiz.
prometheus.rendered.yml

# Claves privadas, certificados y material criptografico
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# --- SECRETOS DE HERRAMIENTAS (tokens de CI, si alguien los guarda aquí) ------
.github/*.token
*.vault
.vault/

# --- DATOS EN EJECUCION DEL STACK (no versionar) -----------------------------
# Instantes del TSDB, silencios, datos de Grafana y de ntfy: pueden contener informacion institucional.
/data/
/backup/
/grafana-data/
/prometheus-data/
/alertmanager-data/
/ntfy-data/

# --- COPIAS Y EXPORTACIONES --------------------------------------------------
# Una copia de Grafana o Alertmanager puede contener usuarios, dashboards con nombres
# de sistemas internos y silencios en vigor.
/backups/*
!/backups/.gitkeep
*.tar.gz
*.tar
*.zip
*.dump
*.sql
*.rdb

# --- PYTHON (ntfy-bridge) ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/
*.egg-info/
dist/
build/

# --- CONTENEDORES (artefactos y el propio .env, si se copia el arbol entero) ---
/docker-build-cache/

# --- EDITORES Y SISTEMA OPERATIVO -------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.~lock.*#
.DS_Store
Thumbs.db
desktop.ini

# --- FICHEROS DE TRABAJO TEMPORALES -----------------------------------------
*.tmp
*.log
*.bak
*.orig
*.rej
scratch/
tmp/