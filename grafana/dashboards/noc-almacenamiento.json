      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "prometheus_tsdb_storage_blocks_bytes / (5 * 1024 * 1024 * 1024) * 100", "legendFormat": "tsdb", "range": true, "refId": "A"} ]
