    },
    { "id": 2,
      "type": "stat",
      "title": "Antigüedad del dato más antiguo",
      "description": "Antigüedad del dato más antiguo que conserva la base. Si coincide con la retención configurada (15 d por defecto), la base está bien. Si es mayor, hay que revisar `--storage.tsdb.retention.time`. También es el límite real de una investigación posterior: si el dato no existe, no hay histórico que mirar.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "time() - prometheus_tsdb_lowest_timestamp_seconds", "legendFormat": "antigüedad", "range": true, "refId": "A"} ]
    },
    { "id": 3,
      "type": "stat",
      "title": "Espacio usado por la base",
