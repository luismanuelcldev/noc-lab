      "options": {"alignValue": "center", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "rowHeight": 0.9, "showValue": "auto", "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "node_time_seconds{job=\"node\"} - node_boot_time_seconds{job=\"node\"} < 900", "legendFormat": "arrancando (<15min)", "range": true, "refId": "A"} ]
