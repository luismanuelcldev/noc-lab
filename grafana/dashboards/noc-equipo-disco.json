{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "Espacio, tendencia de llenado y sistemas de archivos en solo lectura. Un disco lleno detiene las escrituras del TSDB, y con ellas el registro y todo lo que necesite escribir.",
  "editable": false,
  "graphTooltip": 1,
  "links": [{"asDropdown": true, "icon": "external link", "includeVars": false, "keepTime": true, "tags": ["noc"], "targetBlank": false, "title": "Ir a...", "type": "dashboards", "url": ""}],
  "panels": [
    { "id": 1,
      "type": "gauge",
      "title": "Punto de montaje más lleno",
      "description": "El porcentaje más alto de uso entre todos los puntos de montaje. Una sola cifra para saber si algún disco se está llenando. Viene de la serie grabada noc_host_disco_uso_porcentaje, que ya excluye tmpfs, overlay, squashfs y fuse porque reportan 0 bytes usados. El detalle por punto de montaje está en el panel de abajo.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "noc_host_disco_uso_porcentaje{job=\"node\"}", "legendFormat": "{{mountpoint}}", "range": true, "refId": "A"} ]
    },
    { "id": 2,
      "type": "timeseries",
      "title": "Espacio libre por punto de montaje (%)",
      "description": "Como porcentaje libre, que es como se lee el riesgo. Al revés (porcentaje usado) convierte un disco casi lleno en un número alto que parece sano, que es justo cuando no lo es. La alerta de aviso dispara por debajo del 15% libre y la crítica por debajo del 5%.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "100 * node_filesystem_avail_bytes{job=\"node\", fstype!~\"tmpfs|overlay|squashfs|fuse.*|nsfs\"} / node_filesystem_size_bytes{job=\"node\", fstype!~\"tmpfs|overlay|squashfs|fuse.*|nsfs\"}", "legendFormat": "{{mountpoint}}", "range": true, "refId": "A"} ]
    },
    { "id": 3,
      "type": "timeseries",
      "title": "Proyección de llenado a 24 h",
      "description": "predict_linear sobre 6 horas, proyectando 24 horas hacia delante. Atrapa el caso que un umbral fijo no ve: un disco que hoy no falla estará lleno la semana que viene. Necesita 6 horas de histórico; antes de eso la predicción no es fiable y debe ignorarse.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "decimals": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}]}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "predict_linear(node_filesystem_avail_bytes{job=\"node\", fstype!~\"tmpfs|overlay|squashfs|fuse.*|nsfs\"}[6h], 86400) / 1024 / 1024", "legendFormat": "{{mountpoint}} en 24h", "range": true, "refId": "A"} ]
    },
    { "id": 4,
      "type": "table",
      "title": "Sistemas de archivos en solo lectura",
      "description": "Un sistema de archivos que un fallo de hardware deja en solo lectura deja de aceptar escrituras. El sistema sigue en pie, las alertas de disco no disparan, y las bases de datos empiezan a fallar una a una: el síntoma aparece muy lejos de la causa. Por eso tiene su propia alerta.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}}, "overrides": []},
      "options": {"cellHeight": "sm", "showHeader": true},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": false, "__name__": true, "device": true, "fstype": true, "instance": true, "job": true, "mountpoint": true}}}],
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "node_filesystem_readonly{job=\"node\"} == 1", "format": "table", "instant": true, "refId": "A"} ]
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["noc", "equipo", "disco"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
