{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "Memoria, CPU, límite asignado y reinicios de cada contenedor. El límite viene del fichero compose, no de cAdvisor, que solo lo lee del kernel; si aparece como 0, el contenedor se creó sin él.",
  "editable": false,
  "graphTooltip": 1,
  "links": [{"asDropdown": true, "icon": "external link", "includeVars": false, "keepTime": true, "tags": ["noc"], "targetBlank": false, "title": "Ir a...", "type": "dashboards", "url": ""}],
  "panels": [
    { "id": 1,
      "type": "timeseries",
      "title": "Uso de memoria (MiB)",
      "description": "working_set_bytes dividido por 1024 dos veces. working_set es la cifra comparable con el límite del contenedor: suma memoria no intercambiable e intercambiable, y es la que el kernel usa para decidir si hay un OOM.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "container_memory_working_set_bytes{job=\"cadvisor\", name!=\"\"} / 1024 / 1024", "legendFormat": "{{name}}", "range": true, "refId": "A"} ]
    },
    { "id": 2,
      "type": "timeseries",
      "title": "Uso de CPU (núcleos)",
      "description": "Viene de la serie grabada noc_contenedor_cpu_nucleos. La alerta ContenedorUsoCPUAlto dispara por encima de 0,8 núcleos sostenidos durante 5 minutos, que es el umbral que se ve en el panel de resumen.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"decimals": 3, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "noc_contenedor_cpu_nucleos", "legendFormat": "{{name}}", "range": true, "refId": "A"} ]
    },
    { "id": 3,
      "type": "table",
      "title": "Memoria frente al límite, por contenedor",
      "description": "working_set, límite asignado y porcentaje. El límite viene del fichero compose (deploy.resources.limits), no de cAdvisor: cAdvisor solo lo lee del kernel. Si el límite aparece como 0, el contenedor se creó sin él, y esta alerta no lo vigila. Los límites SÍ se aplican, pero hay que recrear los contenedores para que un cambio surta efecto: editar el YAML no modifica un contenedor en marcha.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": [{"matcher": {"id": "byName", "options": "Límite (MiB)"}, "properties": [{"id": "unit", "value": "decmbytes"}]}, {"matcher": {"id": "byName", "options": "Conjunto de trabajo (MiB)"}, "properties": [{"id": "unit", "value": "decmbytes"}]}, {"matcher": {"id": "byName", "options": "% del límite"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "decimals", "value": 1}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 90}]}}]}]},
      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": true, "displayName": "% del límite"}]},
      "transformations": [{"id": "labelsToFields", "options": {"mode": "columns"}}, {"id": "joinByField", "options": {"byField": "name", "mode": "outer"}}, {"id": "organize", "options": {"excludeByName": {"Time": true}, "indexByName": {"name": 0, "Conjunto de trabajo (MiB)": 1, "Límite (MiB)": 2, "% del límite": 3}, "renameByName": {"name": "Contenedor"}}}],
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "max by (name) (container_memory_working_set_bytes{job=\"cadvisor\", name!=\"\"}) / 1024 / 1024", "format": "table", "instant": true, "legendFormat": "Conjunto de trabajo (MiB)", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "max by (name) (container_spec_memory_limit_bytes{job=\"cadvisor\", name!=\"\"}) / 1024 / 1024", "format": "table", "instant": true, "legendFormat": "Límite (MiB)", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "100 * (max by (name) (container_memory_working_set_bytes{job=\"cadvisor\", name!=\"\"}) / on(name) max by (name) (container_spec_memory_limit_bytes{job=\"cadvisor\", name!=\"\"} > 0))", "format": "table", "instant": true, "legendFormat": "% del límite", "refId": "C"}
      ]
    },
    { "id": 4,
      "type": "timeseries",
      "title": "Reinicios por contenedor",
      "description": "changes() sobre container_start_time_seconds en una ventana de 10 minutos. NO uses increase() sobre container_last_seen: esa métrica no es un contador, es una lectura de reloj que avanza de forma continua, así que increase() no detecta ni un solo reinicio. La alerta ContenedorReiniciado cuenta cambios, con un umbral de 2.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "custom": {"drawStyle": "bars", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 70, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "normal"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["max", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "changes(container_start_time_seconds{job=\"cadvisor\", name!=\"\"}[10m])", "legendFormat": "{{name}}", "range": true, "refId": "A"} ]
    }
  ],
