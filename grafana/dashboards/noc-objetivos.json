{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "Estado de cada objetivo que Prometheus recoge, su detalle y su latencia. La primera pregunta cuando algo no funciona es si el objetivo está vivo, porque un objetivo caído no es un servicio caído: es un servicio invisible.",
  "editable": false,
  "graphTooltip": 1,
  "links": [{"asDropdown": true, "icon": "external link", "includeVars": false, "keepTime": true, "tags": ["noc"], "targetBlank": false, "title": "Ir a...", "type": "dashboards", "url": ""}],
  "panels": [
    { "id": 1,
      "type": "stat",
      "title": "Objetivos activos",
      "description": "Número de objetivos que Prometheus está recogiendo. Si baja sin cambios en el repositorio, alguien ha quitado un trabajo del fichero de configuración.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "text", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "count(up == 1)", "legendFormat": "activos", "range": true, "refId": "A"} ]
    },
    { "id": 2,
      "type": "state-timeline",
      "title": "Estado por trabajo (histórico)",
      "description": "Cronología de cada objetivo. La anchura del hueco dice cuánto duró la avería, que es el dato que necesita el análisis posterior.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "index": 1, "text": "CAÍDO"}}, "type": "value"}, {"options": {"1": {"color": "green", "index": 0, "text": "Correcto"}}, "type": "value"}], "custom": {"lineWidth": 0, "fillOpacity": 90, "spanNulls": false}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"alignValue": "center", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "rowHeight": 0.9, "showValue": "auto", "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "up", "legendFormat": "{{job}} / {{instance}}", "range": true, "refId": "A"} ]
    },
    { "id": 3,
      "type": "table",
      "title": "Detalle de objetivos",
      "description": "Valor actual de `up`, duración de la última recogida y el motivo cuando falla. El campo 'Error' viene de la etiqueta `job` de `up`: es el mensaje que devuelve el agente o el error de red, y es la primera pista.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": [{"options": {"0": {"color": "red", "index": 1, "text": "CAÍDO"}}, "type": "value"}, {"options": {"1": {"color": "green", "index": 0, "text": "Correcto"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": [{"matcher": {"id": "byName", "options": "Duration of scrape"}, "properties": [{"id": "unit", "value": "s"}]}]},
      "options": {"cellHeight": "sm", "showHeader": true, "sortBy": [{"desc": false, "displayName": "Job"}]},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "container": true, "endpoint": true, "instance": true, "job": true, "metrics_path": true, "scheme": true, "scrape_interval": true, "service": true}}}],
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "up", "format": "table", "instant": true, "legendFormat": "{{job}} / {{instance}}", "refId": "A"} ]
    },
    { "id": 4,
      "type": "timeseries",
      "title": "Latencia de recogida por objetivo",
      "description": "Una recogida que se acerca a scrape_timeout (10 s en este stack) fallará por tiempo, no por disponibilidad. Mira este panel ANTES que los errores de up.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 3, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 5, "showPoints": "never", "spanNulls": false, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}, "axisSoftMin": 0}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 8}]}}, "overrides": []},
      "options": {"legend": {"calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "scrape_duration_seconds", "legendFormat": "{{job}}", "range": true, "refId": "A"} ]
    },
    { "id": 5,
      "type": "table",
      "title": "Inventario de objetivos (file_sd)",
      "description": "Objetivos que Prometheus ha recibido desde targets/servicios.yml. Añadir un servicio a ese fichero lo incorpora sin tocar ningún otro fichero y sin reiniciar Prometheus, que es exactamente la ventaja de file_sd frente a una lista estática.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}}, "overrides": []},
      "options": {"cellHeight": "sm", "showHeader": true},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "container": true, "endpoint": true, "instance": true, "job": true, "method": true, "metrics_path": true, "scheme": true, "service": true, "target": true, "__name__": true}}}],
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "probe_success{job=\"blackbox-dinamico\"}", "format": "table", "instant": true, "refId": "A"} ]
    }
  ],
