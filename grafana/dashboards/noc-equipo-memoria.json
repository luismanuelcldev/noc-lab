{
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "description": "Memoria del equipo que ejecuta el stack, medida sobre lo disponible y nunca sobre lo libre, que es la diferencia entre no tener falsos positivos y tenerlos de forma sistemática.",
  "editable": false,
  "graphTooltip": 1,
  "links": [{"asDropdown": true, "icon": "external link", "includeVars": false, "keepTime": true, "tags": ["noc"], "targetBlank": false, "title": "Ir a...", "type": "dashboards", "url": ""}],
  "panels": [
    { "id": 1,
      "type": "gauge",
      "title": "Memoria en uso",
      "description": "Viene de la serie grabada noc_host_memoria_uso_porcentaje, calculada sobre MemAvailable y nunca sobre MemFree. MemFree ignora la caché de páginas, que el sistema puede liberar en cualquier momento, así que usarla produce falsos positivos de forma sistemática. La alerta crítica dispara por debajo de 256 MiB disponibles.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 85}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"minVizHeight": 75, "minVizWidth": 75, "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "noc_host_memoria_uso_porcentaje{job=\"node\"}", "legendFormat": "{{instance}}", "range": true, "refId": "A"} ]
    },
    { "id": 2,
      "type": "timeseries",
      "title": "Memoria por tipo (MiB)",
      "description": "Dividido por 1024 dos veces para expresarlo en MiB. Cuidado: PromQL no admite sufijos de bytes en los literales, así que no se puede escribir '256MiB'. Escribirlo hace que Prometheus rechace el fichero de reglas ENTERO y deje de evaluar todas las alertas del grupo, sin avisar.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "fillOpacity": 30, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "normal"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "node_memory_MemTotal_bytes{job=\"node\"} / 1024 / 1024", "legendFormat": "total", "range": true, "refId": "A"} ]
    },
    { "id": 3,
      "type": "timeseries",
      "title": "Memoria disponible frente a usada",
      "description": "`Available` frente a `Used`. La diferencia entre ambas es la memoria que el kernel puede liberar sin swap. Si `Available` baja de 256 MiB, el verdugo de OOM está a un paso de actuar, y matará el proceso más grande, que no siempre es el culpable.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "decmbytes", "decimals": 0, "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "pointSize": 5, "stacking": {"group": "A", "mode": "none"}}, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [ {"datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "expr": "node_memory_MemAvailable_bytes{job=\"node\"} / 1024 / 1024", "legendFormat": "disponible", "range": true, "refId": "A"} ]
    }
  ],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["noc", "equipo", "memoria"],
